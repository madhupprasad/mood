# Release signing config for the Android app.
#
# 1. Copy this file to "keystore.properties" (same folder).
# 2. Fill in the two passwords you set when you ran `keytool -genkey`.
# 3. Never commit keystore.properties — it is gitignored.
#
# storeFile is the keystore you created (absolute path).
storeFile=/Users/madhu/mood-release.keystore
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=mood
keyPassword=YOUR_KEY_PASSWORD
